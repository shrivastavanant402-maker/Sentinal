{
  "name": "aegismesh-vscode",
  "displayName": "AegisMesh IDE Sentinel",
  "description": "Zero-trust runtime policy enforcement and cryptographic integrity for AI agents in VS Code",
  "version": "0.1.0",
  "publisher": "aegismesh",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0a0e1a",
    "theme": "dark"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/shrivastavanant402-maker/Sentinal"
  },
  "bugs": {
    "url": "https://github.com/shrivastavanant402-maker/Sentinal/issues"
  },
  "homepage": "https://github.com/shrivastavanant402-maker/Sentinal#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Security",
    "Linters",
    "Programming Languages"
  ],
  "keywords": [
    "aegismesh",
    "security",
    "zero-trust",
    "runtime integrity",
    "ai agent",
    "policy enforcement",
    "audit ledger",
    "mcp"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aegismesh.showStatus",
        "title": "AegisMesh: Show Status",
        "category": "AegisMesh"
      },
      {
        "command": "aegismesh.checkConnection",
        "title": "AegisMesh: Check Connection",
        "category": "AegisMesh"
      },
      {
        "command": "aegismesh.testAction",
        "title": "AegisMesh: Test Action",
        "category": "AegisMesh"
      },
      {
        "command": "aegismesh.runMission",
        "title": "AegisMesh: Run Mission",
        "category": "AegisMesh"
      }
    ],
    "configuration": {
      "title": "AegisMesh",
      "properties": {
        "aegismesh.backendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "URL of the AegisMesh backend Core API."
        },
        "aegismesh.agentId": {
          "type": "string",
          "default": "ide-agent-01",
          "description": "Agent identifier for IDE action enforcement and audit tracking."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
